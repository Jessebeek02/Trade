//@version=6
strategy("APA - Abrupte Prijs Actie", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=1, initial_capital=10000, currency=currency.USD)

// Bijgewerkt om te matchen met de actuele live-regels in
// docs/apa-signal-strategy.md / docs/apa-signal-loop-local.md.
// Bekende versimpelingen t.o.v. de live-bot:
// - Alle 7 confirmaties zitten erin, maar Volume Profile/POC, VPSV en
//   Supply/Demand zijn hier NATIVE PINE-BENADERINGEN, geen uitlezing van
//   de LuxAlgo-indicatoren die de live-bot gebruikt (dat kan een
//   strategy-script niet):
//   - Volume Profile/POC: een eigen, grof geprijsde volume-profielberekening
//     over `pocLookback` bars (prijs in `pocBins` bakjes, meeste volume =
//     POC) - confirm als de POC buiten de oksel-zone valt.
//   - VPSV: cumulatief sessievolume-delta (op-candles tellen mee als plus,
//     neer-candles als min) sinds sessiestart - confirm als dat de
//     richting bevestigt.
//   - Supply/Demand: nabijheid van een recent pivot-high/low (swing-punt)
//     bij de oksel, als benadering van een liquiditeits-/S&D-zone.
// - Filters om minder maar sterkere setups te krijgen (afwijkt van de
//   live-bot, die blokkeert niets): impuls-drempel en volume-eis staan
//   hoger (2.0x i.p.v. 1.8x - een 2.5x-versie bleek te streng, gaf maar
//   3 trades in 3,5 week). HTF+MTF waren kort een HARDE vereiste (moesten
//   allebei kloppen), maar dat gaf te weinig trades (6) om iets over te
//   zeggen - nu weer een gewone, optionele confirmatie samen met de
//   andere 5, van de 7 moeten er minstens `minConfirmations` (standaard 3)
//   meekloppen (4 werd getest, gaf géén betere kwaliteit, alleen minder
//   trades - teruggezet).
// - Entry wordt NIET meer direct geplaatst zodra de oksel ontstaat. Pas als
//   de prijs `reclaimCandles` (standaard 3) candles op rij volledig (open
//   én close) boven de oksel sluit (long) / onder de oksel sluit (short) -
//   dus de eerdere range daadwerkelijk "wint" - wordt de limit order op
//   het oksel-niveau geplaatst. Eén candle die niet aan de eis voldoet
//   annuleert de wachtende setup. Dit is een correctie op een eerdere
//   versie die direct instapte bij het ontstaan van de oksel.
// - SL staat op het laatste pivot-punt (structuur: bovenkant lokale range
//   voor short, onderkant voor long) i.p.v. een vast percentage - met
//   `slFallbackPercent` als terugvaloptie wanneer er geen bruikbaar
//   pivot-punt is. De SL-afstand is dus per trade anders, maar begrensd
//   op maximaal `maxSlPercent` (standaard 1,0%) - ligt het pivot-punt
//   verder weg, dan wordt de SL afgekapt tot dat maximum.
// - Take-profit schaalt in twee niveaus mee met die (variabele)
//   SL-afstand, als R-multiples (standaard 1R/2,5R, elk instelbaar), i.p.v.
//   een vast percentage of de eerstvolgende liquiditeitszone/swing-high/low
//   uit de cursus. Standaardverdeling: 50% op TP1, 50% op TP2. Was eerst
//   drie niveaus (1R/2R/4R, 40/40/20%), maar met kleine targets en 3 losse
//   exit-orders per trade woog de commissie (MEXC-fees per fill) te zwaar
//   mee - vandaar terug naar twee niveaus. Een bredere TP1 (1,5R) werd ook
//   getest maar verslechterde het resultaat (waarschijnlijk lagere
//   hit-rate op TP1 vóór de SL geraakt wordt) - TP1 staat daarom weer op
//   1R, alleen het aantal exit-orders (2 i.p.v. 3) is teruggebracht. Zodra
//   TP1 raakt, schuift de SL van het resterende deel (TP2) naar de
//   entry-prijs (breakeven) - die trade kan dan geen verlies meer worden.
// - Slechts één actieve pending oksel per richting tegelijk (een nieuwe
//   vervangt de oude) - de live-bot kan meerdere oksels tegelijk
//   bijhouden, dit script niet.
//
// Toepassen op de **3m-chart** (LTF) voor de "echte" APA-setup - HTF/MTF
// worden dan automatisch Daily/15m via request.security, daar hoef je de
// chart niet voor te wisselen. HTF/MTF-inputs staan standaard op "Chart"
// (leeg) = automatisch passend bij de chart-timeframe, dus je kunt dit
// script ook direct op **15m of 1h** draaien (bijv. om met meer
// kalender-historie te testen dan de gratis 3m-databudget toelaat, of om
// long/short apart te vergelijken over bull- én bear-periodes) - MTF/HTF
// schalen dan automatisch mee (15m→MTF 1h/HTF D, 1h→MTF 4h/HTF D). Let
// op: de andere "bars"-instellingen (impuls-lookback, baseBars, ATR/
// volume-lengte, pocLookback, pivotLen, maxBarsWaitFill) blijven native
// chart-bars - hun betekenis in kalendertijd verandert dus mee met de
// gekozen chart-timeframe, dit is dan ook een grovere benadering dan de
// 3m-run.

// ── Inputs ──────────────────────────────────────────────────────────────
// HTF/MTF staan standaard op "Chart" (leeg) = automatisch bepaald op basis
// van de timeframe die je op de chart hebt staan, zodat je dit script ook
// op 15m of 1h kunt draaien (bijv. om long/short apart te checken over een
// langere kalenderperiode dan de 3m-chart gratis toelaat) zonder telkens
// zelf HTF/MTF opnieuw te hoeven instellen. Kies je hier zelf een vaste
// timeframe, dan overschrijft die de automatische keuze.
htfInput        = input.timeframe("", "HTF voor trendbepaling (leeg = automatisch)")
htfEmaLen       = input.int(50, "HTF EMA-lengte (trendfilter)")
mtfInput        = input.timeframe("", "MTF voor tussenliggende confirmatie (leeg = automatisch)")
mtfEmaLen       = input.int(50, "MTF EMA-lengte (trendfilter)")
rangeLen        = input.int(100, "Range-lengte voor range-positie (bars op HTF)")
impulseLookback = input.int(3, "Aantal bars voor impuls-detectie")
impulseAtrMult  = input.float(2.0, "Impuls-drempel (x ATR) - hoger = minder maar overtuigender impulsen")
atrLen          = input.int(14, "ATR-lengte")
volLen          = input.int(20, "Volume-gemiddelde-lengte")
volMult         = input.float(2.0, "Impuls vereist volume x dit gemiddelde - hoger = strenger")
baseBars        = input.int(2, "Aantal candles voor de oksel-basis (bij de oorsprong)")
slFallbackPercent = input.float(0.25, "SL-afstand vanaf entry (%) - fallback als er geen bruikbaar pivot-punt is") / 100
maxSlPercent    = input.float(1.0, "Maximum SL-afstand vanaf entry (%) - kapt de structurele SL af als het pivot-punt te ver weg ligt") / 100
tp1RMultiple    = input.float(1.0, "TP1 (x SL-afstand)")
tp1Portion      = input.float(50, "TP1: % van positie sluiten")
tp2RMultiple    = input.float(2.5, "TP2 (x SL-afstand)")
tp2Portion      = input.float(50, "TP2: % van positie sluiten")
maxBarsWaitFill = input.int(80, "Max bars wachten tot de limit order gevuld wordt")
rangeExtreme    = input.float(0.3, "Range-extreem-marge (0-1, buitenste deel = ongunstig)")
pocLookback     = input.int(50, "Volume Profile/POC-lookback (bars)")
pocBins         = input.int(20, "Aantal prijs-bakjes voor POC-benadering")
pivotLen        = input.int(10, "Pivot-lengte voor Supply/Demand-benadering")
pivotProxAtrMult = input.float(2.0, "Supply/Demand-nabijheid (x ATR)")
minConfirmations = input.int(3, "Min. aantal van de 7 confirmaties (HTF/MTF/Range/VWAP/POC/VPSV/S&D) - zet niet op het maximum (7)")
reclaimCandles  = input.int(3, "Aantal candles die open+close boven/onder de oksel moeten sluiten voordat de trade geplaatst wordt")

// ── Automatische HTF/MTF op basis van de chart-timeframe (LTF) ──────────
f_autoMtf() =>
    string result = switch timeframe.period
        "3"   => "15"
        "15"  => "60"
        "60"  => "240"
        "240" => "D"
        => "60"
    result

f_autoHtf() =>
    string result = switch timeframe.period
        "3"   => "D"
        "15"  => "D"
        "60"  => "D"
        "240" => "W"
        => "D"
    result

htf = htfInput == "" ? f_autoHtf() : htfInput
mtf = mtfInput == "" ? f_autoMtf() : mtfInput

atr    = ta.atr(atrLen)
volAvg = ta.sma(volume, volLen)

// ── HTF-trend (Daily) — confirmatie, blokkeert niets ────────────────────
htfClose = request.security(syminfo.tickerid, htf, close[1], lookahead=barmerge.lookahead_off)
htfEma   = request.security(syminfo.tickerid, htf, ta.ema(close, htfEmaLen)[1], lookahead=barmerge.lookahead_off)
htfUptrend   = htfClose > htfEma
htfDowntrend = htfClose < htfEma

// ── MTF-trend (15m) — confirmatie, blokkeert niets ──────────────────────
mtfClose = request.security(syminfo.tickerid, mtf, close[1], lookahead=barmerge.lookahead_off)
mtfEma   = request.security(syminfo.tickerid, mtf, ta.ema(close, mtfEmaLen)[1], lookahead=barmerge.lookahead_off)
mtfUptrend   = mtfClose > mtfEma
mtfDowntrend = mtfClose < mtfEma

// ── Range-positie (Daily) — confirmatie, blokkeert niets ────────────────
htfRangeHigh = request.security(syminfo.tickerid, htf, ta.highest(high, rangeLen)[1], lookahead=barmerge.lookahead_off)
htfRangeLow  = request.security(syminfo.tickerid, htf, ta.lowest(low, rangeLen)[1], lookahead=barmerge.lookahead_off)
htfRangePos  = (close - htfRangeLow) / (htfRangeHigh - htfRangeLow)  // 0 = onderkant, 1 = bovenkant

// ── VWAP — confirmatie, blokkeert niets ─────────────────────────────────
vwapVal = ta.vwap(hlc3)

// ── Impuls-detectie: overtuigend = ATR-drempel + duidelijk verhoogd volume ─
priceChange       = close - close[impulseLookback]
impulseThreshold  = atr * impulseAtrMult
convincingVolume  = volume > volAvg * volMult
isImpulseUp   = priceChange > impulseThreshold  and convincingVolume
isImpulseDown = priceChange < -impulseThreshold and convincingVolume

// ── Oksel = smal basisgebied bij de OORSPRONG van de impuls ─────────────
// (niet de volledige impuls-afstand - de laatste baseBars candles vlak
// vóór het begin van de beweging)
originHigh = ta.highest(high, baseBars)[impulseLookback]
originLow  = ta.lowest(low, baseBars)[impulseLookback]

// ── Volume Profile/POC-benadering — confirmatie, blokkeert niets ────────
// Grof geprijsde volume-profiel over pocLookback bars: prijsrange verdeeld
// in pocBins bakjes, per bakje het volume opgeteld, bakje met meeste
// volume = POC. Confirm = POC valt buiten de oksel-zone (net als de
// live-regel: POC niet middenin de void).
var float[] pocBinVolumes = array.new_float(0)
pocPrice = 0.0
if barstate.isconfirmed
    float rHigh = ta.highest(high, pocLookback)
    float rLow  = ta.lowest(low, pocLookback)
    float binSize = (rHigh - rLow) / pocBins
    if binSize > 0
        array.clear(pocBinVolumes)
        for i = 0 to pocBins - 1
            array.push(pocBinVolumes, 0.0)
        for i = 0 to pocLookback - 1
            float mid = (high[i] + low[i]) / 2
            int binIdx = int(math.min(math.max((mid - rLow) / binSize, 0), pocBins - 1))
            array.set(pocBinVolumes, binIdx, array.get(pocBinVolumes, binIdx) + volume[i])
        int maxBinIdx = array.indexof(pocBinVolumes, array.max(pocBinVolumes))
        pocPrice := rLow + (maxBinIdx + 0.5) * binSize

// ── VPSV-benadering — cumulatief sessievolume-delta — blokkeert niets ───
newSession = ta.change(time("D")) != 0
var float sessionVolDelta = 0.0
sessionVolDelta := newSession ? (close > open ? volume : -volume) : sessionVolDelta + (close > open ? volume : -volume)

// ── Supply/Demand-benadering — nabijheid recent pivot-punt — blokkeert niets ─
pivotHighVal = ta.pivothigh(high, pivotLen, pivotLen)
pivotLowVal  = ta.pivotlow(low, pivotLen, pivotLen)
var float lastPivotHigh = na
var float lastPivotLow  = na
if not na(pivotHighVal)
    lastPivotHigh := pivotHighVal
if not na(pivotLowVal)
    lastPivotLow := pivotLowVal

// ── Confirmatie-telling per richting (7 optionele confirmaties) ─────────
// HTF/MTF waren kort een harde poort, maar dat gaf te weinig trades om
// iets te kunnen concluderen - nu weer gewone confirmaties, meegeteld
// tegen minConfirmations net als de andere 5.
longRangeOk  = htfRangePos < (1 - rangeExtreme)
longVwapOk   = close < vwapVal
longPocOk    = pocPrice < originLow or pocPrice > originHigh
longVpsvOk   = sessionVolDelta > 0
longSdOk     = not na(lastPivotLow) and math.abs(originLow - lastPivotLow) < atr * pivotProxAtrMult
longConfirmCount = (htfUptrend ? 1 : 0) + (mtfUptrend ? 1 : 0) + (longRangeOk ? 1 : 0) + (longVwapOk ? 1 : 0) + (longPocOk ? 1 : 0) + (longVpsvOk ? 1 : 0) + (longSdOk ? 1 : 0)

shortRangeOk = htfRangePos > rangeExtreme
shortVwapOk  = close > vwapVal
shortPocOk   = pocPrice < originLow or pocPrice > originHigh
shortVpsvOk  = sessionVolDelta < 0
shortSdOk    = not na(lastPivotHigh) and math.abs(originHigh - lastPivotHigh) < atr * pivotProxAtrMult
shortConfirmCount = (htfDowntrend ? 1 : 0) + (mtfDowntrend ? 1 : 0) + (shortRangeOk ? 1 : 0) + (shortVwapOk ? 1 : 0) + (shortPocOk ? 1 : 0) + (shortVpsvOk ? 1 : 0) + (shortSdOk ? 1 : 0)

var int lastLongSignalBar  = na
var int lastShortSignalBar = na

// ── Breakeven-state: zodra TP1 raakt, SL van het resterende deel naar entry ─
var float openEntryPrice = na
var float openTp2Price   = na
var bool  openIsLong     = false
var bool  tp1Filled      = false

// ── Wachtfase: pas plaatsen zodra de oksel "gewonnen" is ────────────────
// Niet meer direct een limit order bij het ontstaan van de oksel - eerst
// moet de prijs `reclaimCandles` candles op rij volledig (open én close)
// boven de oksel sluiten (long) / onder de oksel sluiten (short), als
// bevestiging dat de eerdere range daadwerkelijk teruggewonnen is. Pas
// dan wordt de limit order daadwerkelijk geplaatst, op het oksel-niveau
// van het moment van het signaal (niet het niveau tijdens de bevestiging).
var bool  longPending      = false
var float longEntryPrice   = na
var float longSlPrice      = na
var float longTp1Price     = na
var float longTp2Price     = na
var float longOriginRef    = na
var int   longArmBar       = na
var int   longConfirmBars  = 0

var bool  shortPending      = false
var float shortEntryPrice   = na
var float shortSlPrice      = na
var float shortTp1Price     = na
var float shortTp2Price     = na
var float shortOriginRef    = na
var int   shortArmBar       = na
var int   shortConfirmBars  = 0

// Signaal: oksel + confirmaties kloppen - bereken en bewaar de niveaus,
// maar plaats nog niets. Start de bevestigingsteller.
if isImpulseUp and longConfirmCount >= minConfirmations
    entryPrice = originHigh
    // SL op de onderkant van de recente (lokale) range/structuur - het
    // laatste pivot-low - met een percentage-fallback als dat er niet is
    // of aan de verkeerde kant van entry ligt.
    slPriceRaw = (not na(lastPivotLow) and lastPivotLow < entryPrice) ? lastPivotLow : entryPrice * (1 - slFallbackPercent)
    // Kap de SL-afstand af op maxSlPercent als het pivot-punt te ver weg ligt.
    slPrice    = math.max(slPriceRaw, entryPrice * (1 - maxSlPercent))
    riskDist   = entryPrice - slPrice
    longEntryPrice  := entryPrice
    longSlPrice     := slPrice
    longTp1Price    := entryPrice + riskDist * tp1RMultiple
    longTp2Price    := entryPrice + riskDist * tp2RMultiple
    longOriginRef   := originHigh
    longArmBar      := bar_index
    longConfirmBars := 0
    longPending     := true

if isImpulseDown and shortConfirmCount >= minConfirmations
    entryPrice = originLow
    // SL op de bovenkant van de recente (lokale) range/structuur - het
    // laatste pivot-high - met een percentage-fallback als dat er niet is
    // of aan de verkeerde kant van entry ligt.
    slPriceRaw = (not na(lastPivotHigh) and lastPivotHigh > entryPrice) ? lastPivotHigh : entryPrice * (1 + slFallbackPercent)
    // Kap de SL-afstand af op maxSlPercent als het pivot-punt te ver weg ligt.
    slPrice    = math.min(slPriceRaw, entryPrice * (1 + maxSlPercent))
    riskDist   = slPrice - entryPrice
    shortEntryPrice  := entryPrice
    shortSlPrice     := slPrice
    shortTp1Price    := entryPrice - riskDist * tp1RMultiple
    shortTp2Price    := entryPrice - riskDist * tp2RMultiple
    shortOriginRef   := originLow
    shortArmBar      := bar_index
    shortConfirmBars := 0
    shortPending     := true

// Bevestiging bijhouden (start de bar ná het signaal) - elke candle die
// niet volledig boven/onder de oksel sluit, annuleert de wachtende setup.
if longPending and bar_index > longArmBar
    if open > longOriginRef and close > longOriginRef
        longConfirmBars += 1
        if longConfirmBars >= reclaimCandles
            strategy.cancel("APA Long")
            strategy.entry("APA Long", strategy.long, limit=longEntryPrice)
            strategy.exit("APA Long TP1", "APA Long", qty_percent=tp1Portion, stop=longSlPrice, limit=longTp1Price)
            strategy.exit("APA Long TP2", "APA Long", qty_percent=tp2Portion, stop=longSlPrice, limit=longTp2Price)
            lastLongSignalBar := bar_index
            openEntryPrice    := longEntryPrice
            openTp2Price      := longTp2Price
            openIsLong        := true
            tp1Filled         := false
            longPending       := false
    else
        longPending     := false
        longConfirmBars := 0

if shortPending and bar_index > shortArmBar
    if open < shortOriginRef and close < shortOriginRef
        shortConfirmBars += 1
        if shortConfirmBars >= reclaimCandles
            strategy.cancel("APA Short")
            strategy.entry("APA Short", strategy.short, limit=shortEntryPrice)
            strategy.exit("APA Short TP1", "APA Short", qty_percent=tp1Portion, stop=shortSlPrice, limit=shortTp1Price)
            strategy.exit("APA Short TP2", "APA Short", qty_percent=tp2Portion, stop=shortSlPrice, limit=shortTp2Price)
            lastShortSignalBar := bar_index
            openEntryPrice     := shortEntryPrice
            openTp2Price       := shortTp2Price
            openIsLong         := false
            tp1Filled          := false
            shortPending       := false
    else
        shortPending     := false
        shortConfirmBars := 0

// Detecteer een gedeeltelijke sluiting (TP1 geraakt) via een afname van de
// positiegrootte terwijl er nog een positie open staat, en verplaats dan
// de SL van het resterende deel (TP2) naar de entry-prijs.
if not tp1Filled and strategy.position_size != 0 and math.abs(strategy.position_size) < math.abs(strategy.position_size[1])
    tp1Filled := true
    if openIsLong
        strategy.exit("APA Long TP2", "APA Long", qty_percent=tp2Portion, stop=openEntryPrice, limit=openTp2Price)
    else
        strategy.exit("APA Short TP2", "APA Short", qty_percent=tp2Portion, stop=openEntryPrice, limit=openTp2Price)

if strategy.position_size == 0
    tp1Filled := false

// ── Niet-gevulde limit orders laten vervallen na te lang wachten ────────
if not na(lastLongSignalBar) and (bar_index - lastLongSignalBar > maxBarsWaitFill)
    strategy.cancel("APA Long")
    lastLongSignalBar := na

if not na(lastShortSignalBar) and (bar_index - lastShortSignalBar > maxBarsWaitFill)
    strategy.cancel("APA Short")
    lastShortSignalBar := na

// ── Visuals ───────────────────────────────────────────────────────────
plot(vwapVal, "VWAP", color=color.orange)
plot(originHigh, "Oksel-boven (laatste)", color=color.aqua, style=plot.style_circles, linewidth=2)
plot(originLow, "Oksel-onder (laatste)", color=color.fuchsia, style=plot.style_circles, linewidth=2)
bgcolor(htfUptrend ? color.new(color.green, 95) : htfDowntrend ? color.new(color.red, 95) : na)
